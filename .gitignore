cd /e/DataSciene/TraceGuardAI
cat > .gitignore <<'EOF'
# Python virtual environment
.venv/
venv/

# Python cache and test files
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets and environment variables
.env
.env.*
!.env.example

# Local databases - preserve them on your computer
data/*.db
data/*.sqlite
data/*.sqlite3

# Editor and operating system files
.vscode/
.DS_Store
Thumbs.db
EOF